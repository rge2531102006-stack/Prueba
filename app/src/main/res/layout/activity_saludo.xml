<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".BuscarModificar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAgregarMenu"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/nav_button"
            android:text="Agregar"
            android:textAllCaps="false"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/btnBuscarAccion"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/nav_button"
            android:text="Buscar"
            android:textAllCaps="false"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/btnSalirMenu"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/nav_button"
            android:text="Salir"
            android:textAllCaps="false"
            android:textColor="@color/black" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etClaveBusqueda"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Clave"
                android:inputType="text"
                android:singleLine="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#D6D1C8" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#D6D1C8" />

            <EditText
                android:id="@+id/etNombreModificar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Nombre"
                android:inputType="textPersonName"
                android:singleLine="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D6D1C8" />

            <EditText
                android:id="@+id/etEdadModificar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Edad"
                android:inputType="number"
                android:singleLine="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D6D1C8" />

            <EditText
                android:id="@+id/etTelefonoModificar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Teléfono"
                android:inputType="phone"
                android:singleLine="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D6D1C8" />

            <EditText
                android:id="@+id/etCiudadModificar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Ciudad"
                android:inputType="textCapWords"
                android:singleLine="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>